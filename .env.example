# Copy this file to .env and fill in your values.
# Never commit your real .env file.

# Required — get one from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Optional — enables /weather. Free key from https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Optional — enables higher-rate-limit currency conversion.
# Free key from https://www.exchangerate-api.com/
# If left blank, /convert falls back to a free keyless endpoint.
EXCHANGE_RATE_API_KEY=

# Optional
DATABASE_PATH=data/bot.db
DEFAULT_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
